# ---------- Core ----------
NODE_ENV=development
DATABASE_URL=postgresql://marketing_admin:local_dev_password@localhost:5432/marketing_platform?schema=public
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ALLOWLIST=http://localhost:3000

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# 32-byte key, base64. Used to encrypt social tokens at rest. Use a KMS in production.
TOKEN_ENCRYPTION_KEY=

# ---------- AI ----------
# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------- Storage ----------
# local | s3   (s3 works for AWS S3, Cloudflare R2 and MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=amp-dev
STORAGE_ACCESS_KEY=local_minio
STORAGE_SECRET_KEY=local_minio_password
STORAGE_SIGNING_SECRET=change-me-local-storage-signing-secret

# ---------- Payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Social / OAuth (later phase) ----------
META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
