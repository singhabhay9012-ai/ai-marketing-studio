{
  "name": "@amp/ai",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node -e \"if(!require('fs').readdirSync('dist').some(f=>f.endsWith('.test.js'))){console.error('No compiled test files in dist - refusing to pass with 0 tests');process.exit(1)}\" && node --test dist/*.test.js"
  },
  "dependencies": {
    "@amp/database": "workspace:*",
    "@amp/shared-types": "workspace:*",
    "@amp/validation": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@amp/config": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
