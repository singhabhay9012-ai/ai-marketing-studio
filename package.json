{
  "name": "ai-marketing-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @amp/database generate",
    "db:migrate": "pnpm --filter @amp/database migrate:dev",
    "db:deploy": "pnpm --filter @amp/database migrate:deploy",
    "db:seed": "pnpm --filter @amp/database seed",
    "services:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.29",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "@nestjs/core",
      "msgpackr-extract",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "multer@<2.5.0": "^2.5.0",
      "postcss@<8.5.23": "^8.5.32",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "js-yaml@>=5.0.0 <5.4.1": "^5.5.0"
    }
  }
}
