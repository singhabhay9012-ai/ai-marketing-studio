{
  "name": "ai-marketing-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @amp/database generate",
    "db:migrate": "pnpm --filter @amp/database migrate:dev",
    "db:deploy": "pnpm --filter @amp/database migrate:deploy",
    "db:seed": "pnpm --filter @amp/database seed",
    "services:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "@nestjs/core",
      "msgpackr-extract",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
